    "Xela S2 - Continuous distributions": {
        "scope": "python",
        "prefix": "xelas2",
        "description": "Continuous distribution samplers; requires S1",
        "body": [
            "def sample_normal(n, *, loc=0.0, scale=1.0, rng=None):",
            "    return _rng(rng).normal(loc, scale, size=_n(n))",
            "",
            "def sample_exponential(n, *, scale=1.0, rng=None):",
            "    return _rng(rng).exponential(scale, size=_n(n))",
            "",
            "def sample_uniform(n, *, low=0.0, high=1.0, rng=None):",
            "    return _rng(rng).uniform(low, high, size=_n(n))",
            "",
            "def sample_student_t(n, *, df=5.0, loc=0.0, scale=1.0, rng=None):",
            "    return loc + scale * _rng(rng).standard_t(df, size=_n(n))",
            "",
            "def sample_gamma(n, *, shape=1.0, scale=1.0, rng=None):",
            "    return _rng(rng).gamma(shape, scale, size=_n(n))",
            "",
            "def sample_beta(n, *, a=1.0, b=1.0, rng=None):",
            "    return _rng(rng).beta(a, b, size=_n(n))",
            "",
            "def sample_lognormal(n, *, mean=0.0, sigma=1.0, rng=None):",
            "    return _rng(rng).lognormal(mean, sigma, size=_n(n))",
            "",
            "def sample_laplace(n, *, loc=0.0, scale=1.0, rng=None):",
            "    return _rng(rng).laplace(loc, scale, size=_n(n))",
            "",
            "$0"
        ]
    },
    "Xela S3 - Discrete and categorical distributions": {
        "scope": "python",
        "prefix": "xelas3",
        "description": "Discrete and categorical samplers; requires S1",
        "body": [
            "def sample_bernoulli(n, *, p=0.5, rng=None):",
            "    return _rng(rng).binomial(1, p, size=_n(n))",
            "",
            "def sample_binomial(n, *, trials=1, p=0.5, rng=None):",
            "    return _rng(rng).binomial(trials, p, size=_n(n))",
            "",
            "def sample_poisson(n, *, rate=1.0, rng=None):",
            "    return _rng(rng).poisson(rate, size=_n(n))",
            "",
            "def sample_negative_binomial(n, *, mean=1.0, dispersion=1.0, rng=None):",
            "    p = dispersion / (dispersion + mean)",
            "    return _rng(rng).negative_binomial(dispersion, p, size=_n(n))",
            "",
            "def sample_geometric(n, *, p=0.5, rng=None):",
            "    return _rng(rng).geometric(p, size=_n(n))",
            "",
            "def sample_categorical(n, *, probabilities, rng=None):",
            "    return _rng(rng).choice(len(probabilities), size=_n(n), p=probabilities)",
            "",
            "def sample_multinomial(n, *, trials, probabilities, rng=None):",
            "    return _rng(rng).multinomial(trials, probabilities, size=_n(n))",
            "",
            "$0"
        ]
    },
