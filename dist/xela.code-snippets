    "Xela WRDS2 - CRSP stock prices": {
        "scope": "python",
        "prefix": "xelawrds2",
        "description": "Pulls CRSP prices, shares outstanding, market caps, and company identifiers; filters by exchanges, minimum market cap in USD, dates, and optional PERMNOs; supports daily, monthly, and yearly observations; requires WRDS1",
        "body": [
            "import pandas as pd",
            "",
            "EXCHANGE_MAP = {",
            "    \"NYSE\": 1,",
            "    \"AMEX\": 2,",
            "    \"NASDAQ\": 3,",
            "\\}",
            "",
            "def pull_crsp_stocks(",
            "    start_date,",
            "    end_date,",
            "    market_cap_floor,",
            "    granularity=\"daily\",   # \"daily\", \"monthly\", or \"yearly\"",
            "    exchanges=(\"NYSE\", \"AMEX\", \"NASDAQ\"),",
            "    permnos=None",
            "):",
            "    \"\"\"",
            "    Pull CRSP stocks using CRSP Stock (Annual).",
            "",
            "    granularity:",
            "        - \"daily\"   -> dsf + dsenames",
            "        - \"monthly\" -> msf + msenames",
            "        - \"yearly\"  -> derived from msf by keeping last obs in each year",
            "    \"\"\"",
            "    granularity = granularity.lower().strip()",
            "",
            "    if granularity == \"daily\":",
            "        data_table = \"crsp_a_stock.dsf\"",
            "        name_table = \"crsp_a_stock.dsenames\"",
            "    elif granularity == \"monthly\":",
            "        data_table = \"crsp_a_stock.msf\"",
            "        name_table = \"crsp_a_stock.msenames\"",
            "    elif granularity == \"yearly\":",
            "        data_table = \"crsp_a_stock.msf\"",
            "        name_table = \"crsp_a_stock.msenames\"",
            "    else:",
            "        raise ValueError(\"granularity must be one of: daily, monthly, yearly\")",
            "",
            "",
            "    exchcds = [EXCHANGE_MAP[x.upper()] for x in exchanges]",
            "    exch_clause = \",\".join(str(x) for x in exchcds)",
            "",
            "    permno_clause = \"\"",
            "    if permnos is not None and len(permnos) > 0:",
            "        permno_list = \",\".join(str(int(x)) for x in permnos)",
            "        permno_clause = f\"AND a.permno IN ({permno_list\\})\"",
            "",
            "    sql = f\"\"\"",
            "        SELECT",
            "            a.permno,",
            "            a.permco,",
            "            a.date,",
            "            b.ticker,",
            "            b.comnam,",
            "            b.exchcd,",
            "            b.shrcd,",
            "            a.prc,",
            "            a.shrout,",
            "            ABS(a.prc) * a.shrout * 1000 AS mktcap_usd",
            "        FROM {data_table\\} AS a",
            "        JOIN {name_table\\} AS b",
            "          ON a.permno = b.permno",
            "         AND a.date BETWEEN b.namedt AND b.nameendt",
            "        WHERE a.date BETWEEN %s AND %s",
            "          AND b.exchcd IN ({exch_clause\\})",
            "          AND b.shrcd IN (10, 11)",
            "          AND a.prc IS NOT NULL",
            "          AND a.shrout IS NOT NULL",
            "          AND ABS(a.prc) * a.shrout * 1000 >= %s",
            "          {permno_clause\\}",
            "        ORDER BY a.permno, a.date",
            "    \"\"\"",
            "",
            "    df = conn.raw_sql(sql, params=[start_date, end_date, market_cap_floor])",
            "",
            "    if granularity == \"yearly\" and not df.empty:",
            "        df[\"year\"] = pd.to_datetime(df[\"date\"]).dt.year",
            "        df = (",
            "            df.sort_values([\"permno\", \"date\"])",
            "              .groupby([\"permno\", \"year\"], as_index=False)",
            "              .tail(1)",
            "              .drop(columns=[\"year\"])",
            "              .reset_index(drop=True)",
            "        )",
            "",
            "    return df",
            "",
            "# Example usage",
            "if __name__ == \"__main__\":",
            "    df = pull_crsp_stocks(",
            "        start_date=\"2020-01-01\",",
            "        end_date=\"2024-12-31\",",
            "        market_cap_floor=1_000_000_000,   # \\$1B",
            "        granularity=\"monthly\",            # daily / monthly / yearly",
            "        exchanges=(\"NYSE\", \"AMEX\", \"NASDAQ\"),",
            "        permnos=None                      # or [14593, 10107]",
            "    )",
            "    print(df.head())",
            "",
            "$0"
        ]
    },
    "Xela WRDS3 - Compustat security data": {
        "scope": "python",
        "prefix": "xelawrds3",
        "description": "Pulls Compustat security prices and shares linked to PERMNOs through dated CCM links; filters by exchanges, minimum market cap, dates, and optional PERMNOs; supports field selection and daily, monthly, or yearly observations; requires WRDS1",
        "body": [
            "import pandas as pd",
            "",
            "",
            "def pull_compustat_stocks(",
            "    start_date,",
            "    end_date,",
            "    market_cap_floor,",
            "    granularity=\"daily\",",
            "    exchange_names=(\"NYSE\", \"AMEX\", \"NASDAQ\"),",
            "    permnos=None,",
            "    fields=None,",
            "):",
            "    \"\"\"",
            "    Pull Compustat North America stock data linked to CRSP PERMNOs.",
            "",
            "    Parameters",
            "    ----------",
            "    start_date, end_date : str",
            "        Date range to pull.",
            "    market_cap_floor : float",
            "        Minimum market cap using the existing price * shares calculation.",
            "    granularity : str",
            "        \"daily\", \"monthly\", or \"yearly\".",
            "        Yearly keeps the last qualifying observation per PERMNO per year.",
            "    exchange_names : tuple/list",
            "        Exchange names to keep.",
            "    permnos : list[int] or None",
            "        Restrict to these PERMNOs. None pulls all linked securities.",
            "    fields : list[str] or None",
            "        Output fields to return. None returns all fields in field_map.",
            "",
            "    Notes",
            "    -----",
            "    Requires access to Compustat and the CRSP-Compustat link table.",
            "    Date, exchange, and market-cap filters still apply to selected PERMNOs.",
            "    \"\"\"",
            "    granularity = granularity.lower().strip()",
            "",
            "    if granularity == \"daily\":",
            "        data_table = \"comp_na_daily_all.secd\"",
            "        price_col = \"prccd\"",
            "        shares_col = \"cshoc\"",
            "        year_rollup = False",
            "",
            "    elif granularity in (\"monthly\", \"yearly\"):",
            "        data_table = \"comp_na_daily_all.secm\"",
            "        price_col = \"prccm\"",
            "        shares_col = \"cshom\"",
            "        year_rollup = granularity == \"yearly\"",
            "",
            "    else:",
            "        raise ValueError(",
            "            \"granularity must be one of: daily, monthly, yearly\"",
            "        )",
            "",
            "    field_map = {",
            "        \"permno\": \"l.permno\",",
            "        \"gvkey\": \"a.gvkey\",",
            "        \"iid\": \"a.iid\",",
            "        \"date\": \"a.datadate AS date\",",
            "        \"tic\": \"a.tic\",",
            "        \"conm\": \"a.conm\",",
            "        \"exchg\": \"a.exchg\",",
            "        \"tpci\": \"a.tpci\",",
            "        \"price\": f\"a.{price_col\\} AS price\",",
            "        \"shares_outstanding\": (",
            "            f\"a.{shares_col\\} AS shares_outstanding\"",
            "        ),",
            "        \"mktcap_usd\": (",
            "            f\"ABS(a.{price_col\\}) * a.{shares_col\\} AS mktcap_usd\"",
            "        ),",
            "    \\}",
            "",
            "    if fields is None:",
            "        requested_fields = list(field_map)",
            "",
            "    else:",
            "        if isinstance(fields, str):",
            "            raise TypeError(",
            "                \"fields must be a list of field names, not a string.\"",
            "            )",
            "",
            "        requested_fields = list(dict.fromkeys(fields))",
            "",
            "        if not requested_fields:",
            "            raise ValueError(\"fields must contain at least one field.\")",
            "",
            "        invalid_fields = [",
            "            field for field in requested_fields",
            "            if field not in field_map",
            "        ]",
            "",
            "        if invalid_fields:",
            "            raise ValueError(",
            "                f\"Unknown fields: {invalid_fields\\}. \"",
            "                f\"Available fields: {list(field_map)\\}\"",
            "            )",
            "",
            "    # Include identifiers internally for duplicate checks and yearly rollup.",
            "    query_fields = requested_fields.copy()",
            "",
            "    for field in (\"permno\", \"gvkey\", \"iid\", \"date\"):",
            "        if field not in query_fields:",
            "            query_fields.append(field)",
            "",
            "    select_clause = \",\\\\n            \".join(",
            "        field_map[field] for field in query_fields",
            "    )",
            "",
            "    exchange_names = list(exchange_names)",
            "",
            "    if not exchange_names:",
            "        raise ValueError(",
            "            \"exchange_names must contain at least one exchange.\"",
            "        )",
            "",
            "    exchange_placeholders = \", \".join(",
            "        [\"%s\"] * len(exchange_names)",
            "    )",
            "",
            "    params = list(exchange_names)",
            "",
            "    permno_clause = \"\"",
            "",
            "    if permnos is not None:",
            "        if isinstance(permnos, (str, bytes)):",
            "            raise TypeError(\"permnos must be a list of integers.\")",
            "",
            "        permnos = list(dict.fromkeys(int(value) for value in permnos))",
            "",
            "        if not permnos:",
            "            raise ValueError(",
            "                \"permnos cannot be empty. Use None for all linked securities.\"",
            "            )",
            "",
            "        placeholders = \", \".join([\"%s\"] * len(permnos))",
            "        permno_clause = f\"AND lpermno IN ({placeholders\\})\"",
            "        params.extend(permnos)",
            "",
            "    params.extend([start_date, end_date, market_cap_floor])",
            "",
            "    sql = f\"\"\"",
            "        WITH ex_codes AS (",
            "            SELECT DISTINCT code",
            "            FROM comp_na_daily_all.r_ex_codes",
            "            WHERE description IN ({exchange_placeholders\\})",
            "        ),",
            "        links AS (",
            "            SELECT DISTINCT",
            "                gvkey,",
            "                liid AS iid,",
            "                lpermno AS permno,",
            "                linkdt,",
            "                linkenddt",
            "            FROM crsp_a_ccm.ccmxpf_linktable",
            "            WHERE lpermno IS NOT NULL",
            "              AND linktype IN ('LC', 'LU')",
            "              {permno_clause\\}",
            "        )",
            "        SELECT",
            "            {select_clause\\}",
            "        FROM {data_table\\} AS a",
            "        JOIN ex_codes AS e",
            "          ON a.exchg = e.code",
            "        JOIN links AS l",
            "          ON a.gvkey = l.gvkey",
            "         AND a.iid = l.iid",
            "         AND a.datadate BETWEEN",
            "             COALESCE(l.linkdt, DATE '1900-01-01')",
            "             AND COALESCE(l.linkenddt, DATE '9999-12-31')",
            "        WHERE a.datadate BETWEEN %s AND %s",
            "          AND a.tpci = '0'",
            "          AND a.{price_col\\} IS NOT NULL",
            "          AND a.{shares_col\\} IS NOT NULL",
            "          AND ABS(a.{price_col\\}) * a.{shares_col\\} >= %s",
            "        ORDER BY l.permno, a.datadate, a.gvkey, a.iid",
            "    \"\"\"",
            "",
            "",
            "",
            "    df = conn.raw_sql(sql, params=params)",
            "    ",
            "    if not df.empty:",
            "        df[\"permno\"] = df[\"permno\"].astype(\"int64\")",
            "        df[\"date\"] = pd.to_datetime(df[\"date\"])",
            "",
            "        # Overlapping link records can produce identical rows.",
            "        df = df.drop_duplicates().reset_index(drop=True)",
            "",
            "        if df.duplicated([\"permno\", \"date\"]).any():",
            "            raise ValueError(",
            "                \"Multiple Compustat observations map to the same \"",
            "                \"PERMNO and date. Check the CCM links before proceeding.\"",
            "            )",
            "",
            "        if year_rollup:",
            "            df[\"year\"] = df[\"date\"].dt.year",
            "",
            "            df = (",
            "                df.sort_values([\"permno\", \"date\"])",
            "                  .groupby([\"permno\", \"year\"], as_index=False)",
            "                  .tail(1)",
            "                  .drop(columns=[\"year\"])",
            "                  .reset_index(drop=True)",
            "            )",
            "",
            "    return df.loc[:, requested_fields]",
            "",
            "",
            "# Example usage",
            "if __name__ == \"__main__\":",
            "    df = pull_compustat_stocks(",
            "        start_date=\"2020-01-01\",",
            "        end_date=\"2024-12-31\",",
            "        market_cap_floor=1_000_000_000,",
            "        granularity=\"monthly\",",
            "        exchange_names=(\"NYSE\", \"AMEX\", \"NASDAQ\"),",
            "        permnos=[14593, 10107],",
            "        fields=[\"permno\", \"date\", \"conm\", \"price\", \"mktcap_usd\"],",
            "        # permnos=None pulls all linked securities.",
            "        # fields=None returns all fields in field_map.",
            "    )",
            "",
            "    print(df.head())",
            "",
            "$0"
        ]
    },
    "Xela WRDS4 - CRSP stock returns": {
        "scope": "python",
        "prefix": "xelawrds4",
        "description": "Pulls CRSP returns with optional delisting adjustments enabled by default; filters by exchanges, minimum market cap in millions of USD, dates, and optional PERMNOs; supports daily, monthly, and compounded yearly returns; requires WRDS1",
        "body": [
            "import pandas as pd",
            "import numpy as np",
            "",
            "EXCHCD = {\"NYSE\": 1, \"AMEX\": 2, \"NASDAQ\": 3\\}",
            "",
            "def pull_crsp_stock_returns(",
            "    start_date,",
            "    end_date,",
            "    market_cap_floor_mm=0.0,",
            "    granularity=\"daily\",               # daily | monthly | yearly",
            "    exchanges=(\"NYSE\", \"AMEX\", \"NASDAQ\"),",
            "    permnos=None,",
            "    include_delisting_returns=True,    # default ON",
            "):",
            "    granularity = granularity.lower().strip()",
            "    exchanges = [e.upper() for e in exchanges]",
            "    exchcds = [EXCHCD[e] for e in exchanges]",
            "",
            "    if granularity == \"daily\":",
            "        stock_table = \"dseall\" if include_delisting_returns else \"dsf\"",
            "        names_table = \"dsenames\"",
            "    elif granularity in (\"monthly\", \"yearly\"):",
            "        stock_table = \"mseall\" if include_delisting_returns else \"msf\"",
            "        names_table = \"msenames\"",
            "    else:",
            "        raise ValueError(\"granularity must be one of: daily, monthly, yearly\")",
            "",
            "",
            "    select_cols = \"\"\"",
            "        a.permno,",
            "        a.date,",
            "        a.ret,",
            "        a.prc,",
            "        a.shrout,",
            "        a.dlret,",
            "        ABS(a.prc) * a.shrout / 1000.0 AS mktcap_mm",
            "    \"\"\" if include_delisting_returns else \"\"\"",
            "        a.permno,",
            "        a.date,",
            "        a.ret,",
            "        a.prc,",
            "        a.shrout,",
            "        NULL::numeric AS dlret,",
            "        ABS(a.prc) * a.shrout / 1000.0 AS mktcap_mm",
            "    \"\"\"",
            "",
            "    sql = f\"\"\"",
            "        SELECT",
            "            {select_cols\\}",
            "        FROM crsp_a_stock.{stock_table\\} AS a",
            "        JOIN crsp_a_stock.{names_table\\} AS n",
            "          ON a.permno = n.permno",
            "         AND a.date BETWEEN n.namedt AND n.nameendt",
            "        WHERE a.date BETWEEN %(start_date)s AND %(end_date)s",
            "          AND n.exchcd = ANY(%(exchcds)s)",
            "          AND n.shrcd IN (10, 11)",
            "    \"\"\"",
            "",
            "    params = {",
            "        \"start_date\": start_date,",
            "        \"end_date\": end_date,",
            "        \"exchcds\": exchcds,",
            "    \\}",
            "",
            "    if permnos:",
            "        sql += \" AND a.permno = ANY(%(permnos)s)\"",
            "        params[\"permnos\"] = permnos",
            "",
            "    df = conn.raw_sql(sql, params=params, date_cols=[\"date\"])",
            "",
            "    if df.empty:",
            "        return df",
            "",
            "    df = df[df[\"mktcap_mm\"] >= market_cap_floor_mm].copy()",
            "",
            "    if include_delisting_returns:",
            "        # If dlret exists, merge it into the period return",
            "        df[\"adj_ret\"] = df[\"ret\"]",
            "        has_dl = df[\"dlret\"].notna()",
            "",
            "        both = has_dl & df[\"ret\"].notna()",
            "        only_dl = has_dl & df[\"ret\"].isna()",
            "",
            "        df.loc[both, \"adj_ret\"] = (1 + df.loc[both, \"ret\"]) * (1 + df.loc[both, \"dlret\"]) - 1",
            "        df.loc[only_dl, \"adj_ret\"] = df.loc[only_dl, \"dlret\"]",
            "    else:",
            "        df[\"adj_ret\"] = df[\"ret\"]",
            "",
            "    if granularity == \"yearly\":",
            "        df[\"year\"] = df[\"date\"].dt.year",
            "        out = (",
            "            df.dropna(subset=[\"adj_ret\"])",
            "              .groupby([\"permno\", \"year\"], as_index=False)",
            "              .agg(",
            "                  annual_ret=(\"adj_ret\", lambda x: (1 + x).prod() - 1),",
            "                  last_date=(\"date\", \"max\"),",
            "                  last_mktcap_mm=(\"mktcap_mm\", \"last\"),",
            "              )",
            "              .sort_values([\"permno\", \"year\"])",
            "              .reset_index(drop=True)",
            "        )",
            "        return out",
            "",
            "    return df.sort_values([\"permno\", \"date\"]).reset_index(drop=True)",
            "",
            "$0"
        ]
    }
}
